{
	"name": "@basemark/cli",
	"version": "0.0.0",
	"description": "Build/render tooling for basemark — renders a markdown(+directives) file to one self-contained HTML file",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"basemark": "./src/index.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"bundle:runtime": "bun run scripts/bundle-runtime.ts",
		"postinstall": "bun run bundle:runtime",
		"build": "bun run bundle:runtime && bun build --compile --outfile=dist/basemark ./src/index.ts"
	},
	"dependencies": {
		"@basemark/bio": "workspace:*",
		"@basemark/charts": "workspace:*",
		"@basemark/common": "workspace:*",
		"@basemark/core": "workspace:*",
		"hast-util-to-html": "^9.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@basemark/tsconfig-base": "workspace:*",
		"@types/bun": "^1.3.10",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.2.0"
	}
}
