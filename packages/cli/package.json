{
	"name": "@basemark/cli",
	"version": "0.1.3",
	"description": "Build/render tooling for basemark — renders a markdown(+directives) file to one self-contained HTML file",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vilas-gannaram/basemark.git",
		"directory": "packages/cli"
	},
	"homepage": "https://vilas-gannaram.github.io/basemark",
	"bugs": "https://github.com/vilas-gannaram/basemark/issues",
	"type": "module",
	"bin": {
		"basemark": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"check-types": "tsc --noEmit",
		"bundle:runtime": "node scripts/bundle-runtime.ts",
		"build:skill": "node scripts/build-skill.ts",
		"build": "pnpm run bundle:runtime && pnpm run build:skill && tsup"
	},
	"devDependencies": {
		"@basemark/bio": "workspace:*",
		"@basemark/charts": "workspace:*",
		"@basemark/common": "workspace:*",
		"@basemark/core": "workspace:*",
		"@basemark/tsconfig-base": "workspace:*",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.2.0",
		"hast-util-to-html": "^9.0.5",
		"unist-util-visit": "^5.1.0"
	}
}
