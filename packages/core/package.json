{
	"name": "@basemark/core",
	"version": "0.0.0",
	"description": "Markdown + directive parser and component registry — framework-agnostic",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"hast-util-to-dom": "^4.0.1",
		"hast-util-to-html": "^9.0.5",
		"mdast-util-directive": "^3.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@basemark/tsconfig-base": "workspace:*",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"vitest": "^4.1.10"
