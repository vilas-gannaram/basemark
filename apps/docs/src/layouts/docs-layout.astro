---
import '@basemark/core/theme.css';
import '../styles/docs.css';
import type { ITocItem } from '../lib/toc';

interface Props {
	title: string;
	toc?: ITocItem[];
	// Relative to apps/docs/; omit for pages with no single source file
	// (the data-driven component-reference pages).
	editPath?: string;
	// Landing-page treatment (currently just "/") — CSS-only styling, no
	// hand-written copy.
	hero?: boolean;
	// Homepage skips the generic page <h1>; introduction.md's own opening
	// paragraph reads as the tagline instead.
	hideTitle?: boolean;
}

const { title, toc = [], editPath, hero = false, hideTitle = false } = Astro.props;
const REPO = 'https://github.com/vilas-gannaram/basemark';

const NAV = [
	{
		label: 'Overview',
		items: [
			{ href: '/', label: 'Introduction' },
			{ href: '/getting-started', label: 'Getting started' },
			{ href: '/examples', label: 'Examples' },
		],
	},
	{
		label: 'Core',
		items: [
			{ href: '/core', label: 'Overview' },
			{ href: '/authoring/syntax', label: 'Authoring syntax' },
			{ href: '/authoring/tiering', label: 'Tiering model' },
		],
	},
	{
		label: 'Common',
		items: [
			{ href: '/components/common', label: 'Components' },
			{ href: '/examples/common', label: 'Examples' },
		],
	},
	{
		label: 'Bio',
		items: [
			{ href: '/components/bio', label: 'Components' },
			{ href: '/examples/bio', label: 'Examples' },
		],
	},
	{
		label: 'Charts',
		items: [
			{ href: '/components/charts', label: 'Components' },
			{ href: '/examples/charts', label: 'Examples' },
		],
	},
	{
		label: 'CLI',
		items: [{ href: '/cli', label: 'Overview' }],
	},
];

// Strips the configured `base` (present in the built site, not `dev`) so
// this compares against NAV's plain, base-less hrefs; a naive .replace()
// left a doubled '//core' instead, so strip as a prefix, not in place.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = (base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(
	/\/$/,
	'',
) || '/';

// Prev/next reading order, flattened from NAV. Keeps each item's group
// label too — "Components"/"Examples" alone repeats across packs.
const FLAT_NAV = NAV.flatMap((group) => group.items.map((item) => ({ ...item, group: group.label })));
const currentIndex = FLAT_NAV.findIndex((item) => item.href === currentPath);
const prevItem = currentIndex > 0 ? FLAT_NAV[currentIndex - 1] : undefined;
const nextItem = currentIndex >= 0 && currentIndex < FLAT_NAV.length - 1 ? FLAT_NAV[currentIndex + 1] : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — Basemark</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet" />
		{
			// Pagefind's index only exists after `astro build && pagefind --site dist`,
			// so search is production-only — unreachable in `astro dev`.
			!import.meta.env.DEV && (
				<>
					<link href={`${base}/pagefind/pagefind-component-ui.css`} rel="stylesheet" />
					<script is:inline src={`${base}/pagefind/pagefind-component-ui.js`} type="module" />
					{
						// Auto-detection isn't reliable under a GitHub Pages subpath; set
						// bundle-path explicitly, before pagefind-modal-trigger connects.
					}
					<pagefind-config bundle-path={`${base}/pagefind/`} />
				</>
			)
		}
		<script is:inline>
			// Applied before first paint — register.ts loads too late and would
			// flash the light theme first.
			if (localStorage.getItem('basemark-docs-theme') === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body>
		<div class="docs-shell">
			<nav class="docs-sidebar" aria-label="Documentation">
				<div class="docs-sidebar-header">
					<a class="docs-brand" href={base || '/'}>Basemark</a>
					<div class="docs-sidebar-header-actions">
						{!import.meta.env.DEV && (
							<pagefind-modal-trigger class="docs-search-trigger" compact hide-shortcut aria-label="Search" />
						)}
						<button id="theme-toggle" class="docs-theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
					</div>
				</div>
				{!import.meta.env.DEV && <pagefind-modal />}
				{
					NAV.map((group) => (
						<div class="docs-nav-group">
							<p class="docs-nav-label">{group.label}</p>
							<ul>
								{group.items.map((item) => (
									<li>
										<a href={base + item.href} class={item.href === currentPath ? 'active' : undefined}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
				<div class="docs-sidebar-footer">
					<a href={REPO} target="_blank" rel="noreferrer">
						GitHub
					</a>
					<a href="https://www.npmjs.com/package/@basemark/core" target="_blank" rel="noreferrer">
						npm
					</a>
					<a href={`${REPO}/blob/main/LICENSE`} target="_blank" rel="noreferrer">
						MIT License
					</a>
				</div>
			</nav>
			<main class={hero ? 'docs-content docs-hero' : 'docs-content'}>
				<article class="docs-article typeset typeset-docs" data-pagefind-body>
					{!hideTitle && <h1>{title}</h1>}
					{
						editPath && (
							<a class="docs-edit-link" data-pagefind-ignore href={`${REPO}/edit/main/apps/docs/${editPath}`} target="_blank" rel="noreferrer">
								Edit this page on GitHub →
							</a>
						)
					}
					<slot />
					{
						(prevItem || nextItem) && (
							<nav class="docs-prev-next" aria-label="Prev/next" data-pagefind-ignore>
								{prevItem ? (
									<a class="docs-prev-next-link docs-prev" href={base + prevItem.href}>
										<span class="docs-prev-next-label">← Previous</span>
										<span class="docs-prev-next-title">
											{prevItem.group} — {prevItem.label}
										</span>
									</a>
								) : (
									<span />
								)}
								{nextItem && (
									<a class="docs-prev-next-link docs-next" href={base + nextItem.href}>
										<span class="docs-prev-next-label">Next →</span>
										<span class="docs-prev-next-title">
											{nextItem.group} — {nextItem.label}
										</span>
									</a>
								)}
							</nav>
						)
					}
				</article>
				{
					toc.length > 0 && (
						<aside class="docs-toc" aria-label="On this page">
							<p class="docs-toc-label">On this page</p>
							<ul>
								{toc.map((item) => (
									<li class={item.level === 3 ? 'docs-toc-sub' : undefined}>
										<a href={`#${item.id}`}>{item.text}</a>
									</li>
								))}
							</ul>
						</aside>
					)
				}
			</main>
		</div>
		<script is:inline>
			document.getElementById('theme-toggle').addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('basemark-docs-theme', isDark ? 'dark' : 'light');
			});
		</script>
		<script>
			// A real module script — frontmatter runs at build time in Node and
			// never reaches the browser.
			import '../client/register.ts';
		</script>
	</body>
</html>
