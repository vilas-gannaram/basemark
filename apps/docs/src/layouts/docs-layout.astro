---
import '@basemark/core/theme.css';
import '../styles/docs.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const NAV = [
	{
		label: 'Overview',
		items: [
			{ href: '/', label: 'Introduction' },
			{ href: '/getting-started', label: 'Getting started' },
			{ href: '/examples', label: 'Examples' },
		],
	},
	{
		label: 'Core',
		items: [
			{ href: '/core', label: 'Overview' },
			{ href: '/authoring/syntax', label: 'Authoring syntax' },
			{ href: '/authoring/tiering', label: 'Tiering model' },
		],
	},
	{
		label: 'Common',
		items: [
			{ href: '/components/common', label: 'Components' },
			{ href: '/examples/common', label: 'Examples' },
		],
	},
	{
		label: 'Bio',
		items: [
			{ href: '/components/bio', label: 'Components' },
			{ href: '/examples/bio', label: 'Examples' },
		],
	},
	{
		label: 'Charts',
		items: [
			{ href: '/components/charts', label: 'Components' },
			{ href: '/examples/charts', label: 'Examples' },
		],
	},
	{
		label: 'CLI',
		items: [{ href: '/cli', label: 'Overview' }],
	},
];

// Strips the configured `base` (only present in the built site, not `dev` —
// see astro.config.mjs) so it compares against NAV's plain, base-less
// hrefs, then drops any trailing slash so '/core' and '/core/' both match.
// Strips the configured `base` (present in Astro.url.pathname for a built
// site, not in dev — see astro.config.mjs) so it compares against NAV's
// plain, base-less hrefs. import.meta.env.BASE_URL and Astro.url.pathname
// disagree on trailing slash ('/Basemark' vs '/Basemark/core/'), so this
// strips base as a prefix rather than naively .replace()-ing it in place —
// a plain replace with '/' left a doubled '//core' (confirmed by building).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = (base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(
	/\/$/,
	'',
) || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — Basemark</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script is:inline>
			// Applied before first paint (not in the client register.ts module,
			// which loads too late and would flash the light theme first) — reads
			// the same localStorage key the toggle button in this layout writes.
			if (localStorage.getItem('basemark-docs-theme') === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body>
		<div class="docs-shell">
			<nav class="docs-sidebar" aria-label="Documentation">
				<div class="docs-sidebar-header">
					<a class="docs-brand" href={base || '/'}>Basemark</a>
					<button id="theme-toggle" class="docs-theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
				</div>
				{
					NAV.map((group) => (
						<div class="docs-nav-group">
							<p class="docs-nav-label">{group.label}</p>
							<ul>
								{group.items.map((item) => (
									<li>
										<a href={base + item.href} class={item.href === currentPath ? 'active' : undefined}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
			<main class="docs-content">
				<h1>{title}</h1>
				<slot />
			</main>
		</div>
		<script is:inline>
			document.getElementById('theme-toggle').addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('basemark-docs-theme', isDark ? 'dark' : 'light');
			});
		</script>
		<script>
			// A real module script (not frontmatter — frontmatter runs at build
			// time in Node, never reaches the browser). Upgrades the
			// already-resolved custom-element tags renderMarkdownToHtml() baked
			// into this page's static HTML.
			import '../client/register.ts';
		</script>
	</body>
</html>
